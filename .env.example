# Copy to .env (or set in Dokploy → Environment). No secrets are required here.

NODE_ENV=production
PORT=3000
APP_PORT=3000
LOG_LEVEL=info

DATABASE_PATH=/data/app/app.db
# Persist generation transcripts in SQLite for debugging (off by default).
PERSIST_TRANSCRIPTS=false

CODEX_HOME=/data/codex
CODEX_TURN_TIMEOUT_MS=180000

ASR_URL=http://asr:8000
ASR_PROVIDER=funasr
ASR_MODEL=FunAudioLLM/Fun-ASR-Nano-2512
# hf (Hugging Face) or ms (ModelScope)
ASR_MODEL_HUB=hf
# zh | en | ja | auto
ASR_LANGUAGE=zh
ASR_DEVICE=cuda
ASR_MAX_CONCURRENCY=2
# OpenCC config for ASR output. s2tw = Taiwan-standard characters, no vocabulary rewriting.
ASR_OPENCC_CONFIG=s2tw
ASR_TIMEOUT_MS=900000

# Organization-wide recognition hotwords (comma-separated). Per-workspace terms are set in the UI.
HOTWORDS=

MAX_AUDIO_MINUTES=60
MAX_AUDIO_BYTES=262144000

# GPU selection for the asr service (e.g. 0 or 0,1).
NVIDIA_VISIBLE_DEVICES=all

# Behind a reverse proxy (Dokploy/Traefik) keep this true.
TRUST_PROXY=true
