# Copy to .env (or set in Dokploy → Environment). No secrets are required here.

NODE_ENV=production
PORT=3000
# Host port for local access (bound to APP_BIND, default 127.0.0.1). Dokploy uses :3000 itself.
APP_BIND=127.0.0.1
APP_PORT=8080
LOG_LEVEL=info

DATABASE_PATH=/data/app/interview.db
# Every utterance's audio is kept here so transcript lines can be played back.
AUDIO_DIR=/data/app/audio

CODEX_HOME=/data/codex
CODEX_TURN_TIMEOUT_MS=180000
# Model used until one is picked in the UI (falls back to the Codex default if unknown).
# Analysis runs after every pause in the conversation, so a fast model matters: measured on a
# 17-line interview, gpt-6-luna/low took 6-46 s per pass, gpt-6.1-sol/low 28-134 s.
DEFAULT_MODEL=gpt-6-luna
# Quiet period after the latest utterance before the case is re-analyzed.
ANALYSIS_DEBOUNCE_MS=1500

ASR_URL=http://asr:8000
ASR_PROVIDER=funasr
ASR_MODEL=FunAudioLLM/Fun-ASR-Nano-2512
# hf (Hugging Face) or ms (ModelScope)
ASR_MODEL_HUB=hf
# zh | en | ja | auto
ASR_LANGUAGE=zh
ASR_DEVICE=cuda
ASR_MAX_CONCURRENCY=2
# OpenCC config for ASR output. s2tw = Taiwan-standard characters, no vocabulary rewriting.
ASR_OPENCC_CONFIG=s2tw
ASR_TIMEOUT_MS=900000

# Organization-wide recognition hotwords (comma-separated). More terms can be added in the UI.
HOTWORDS=

# The browser cuts speech at pauses; continuous speech is cut at this length.
MAX_UTTERANCE_SECONDS=30
MAX_AUDIO_BYTES=16777216

# GPU selection for the asr service (e.g. 0 or 0,1).
NVIDIA_VISIBLE_DEVICES=all

# Behind a reverse proxy (Dokploy/Traefik) keep this true.
TRUST_PROXY=true
